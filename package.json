{
  "name": "historyofatlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "preview": "serve out -l 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:performance": "playwright test --config playwright.performance.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "data:build": "tsx pipeline/index.ts",
    "data:battles": "tsx pipeline/battles/build.ts",
    "data:battles:acquire": "python3 pipeline/battles/acquire.py",
    "data:battles:cdb90": "python3 pipeline/battles/import_cdb90.py",
    "data:battles:check": "tsx pipeline/battles/check.ts",
    "data:resources": "tsx pipeline/resources/build.ts",
    "data:resources:check": "tsx pipeline/resources/check.ts",
    "data:geo": "tsx pipeline/geography/build.ts",
    "data:check": "tsx scripts/check-dossiers.ts",
    "check": "pnpm typecheck && pnpm test && pnpm lint",
    "predev": "node scripts/prepare-map-assets.mjs",
    "prebuild": "node scripts/prepare-map-assets.mjs",
    "audit:lighthouse": "node scripts/run-lighthouse.mjs",
    "measure:bundle": "node scripts/measure-bundle.mjs",
    "measure:runtime": "node scripts/measure-runtime.mjs"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9.2.0",
    "@deck.gl/core": "^9.2.0",
    "@deck.gl/geo-layers": "^9.2.0",
    "@deck.gl/layers": "^9.2.0",
    "@deck.gl/mapbox": "^9.2.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@turf/boolean-point-in-polygon": "^7.2.0",
    "@turf/helpers": "^7.2.0",
    "@turf/point-to-line-distance": "^7.2.0",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "6.10.0",
    "minisearch": "^7.2.0",
    "next": "16.3.5",
    "pmtiles": "^4.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@lhci/cli": "^0.15.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.186.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.6.0",
    "serve": "^14.2.4",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  }
}
